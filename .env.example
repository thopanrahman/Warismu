# Contoh env — copy ke .env.local lalu isi (JANGAN commit .env.local).
# Di Vercel: isi lewat dashboard Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string (pakai port 6543 pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxx:RAHASIA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ---- LLM 1: Gemini (utama) ----
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.contoh-kunci-gemini
# Model utama; rantai fallback internal: gemini-3.5-flash → gemini-flash-lite
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=15000
# Opsional: URL manual (mis. stub uji lokal). Kosongkan untuk produksi.
# GEMINI_API_URL=

# ---- LLM 2: DeepSeek (fallback kedua) ----
# https://platform.deepseek.com/api_keys - endpoint kompatibel OpenAI
DEEPSEEK_API_KEY=sk-contoh-kunci-deepseek
DEEPSEEK_MODEL=deepseek-chat
# Opsional: override endpoint (default https://api.deepseek.com/chat/completions)
# DEEPSEEK_API_URL=

# ---- LLM 3: OpenAI (fallback ketiga) ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-contoh-kunci-openai
OPENAI_MODEL=gpt-4o-mini
# Opsional: override endpoint (default https://api.openai.com/v1/chat/completions)
# OPENAI_API_URL=

# Batas waktu per penyedia LLM (ms) dan pagu total seluruh rantai fallback (ms).
# Bila semua penyedia gagal, /api/chat membalas mockResponse (mode mock).
LLM_TIMEOUT_MS=15000
LLM_TOTAL_TIMEOUT_MS=45000

# String acak panjang untuk tanda tangan JWT
JWT_SECRET=ganti-dengan-string-acak-panjang

# Opsional: pakai Faraidh-API daring. Kosongkan agar mesin hitung lokal dipakai.
# FARAIDH_API_URL=
