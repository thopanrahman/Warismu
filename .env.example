# Contoh env — copy ke .env.local lalu isi (JANGAN commit .env.local).
# Di Vercel: isi lewat dashboard Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string (pakai port 6543 pooler)
DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_gemini_di_sini

# String acak panjang untuk tanda tangan JWT
JWT_SECRET=ganti_dengan_string_acak_panjang
