# Contoh env — copy ke .env.local lalu isi (JANGAN commit .env.local).
# Di Vercel: isi lewat dashboard Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string (pakai port 6543 pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxx:RAHASIA@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ---- LLM 1: Gemini (utama) ----
# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.contoh-kunci-gemini
# Model utama; rantai fallback internal: GEMINI_MODEL → GEMINI_MODEL_CADANGAN.
# gemini-3.5-flash-lite lebih stabil/cepat daripada gemini-3.5-flash.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_CADANGAN=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=12000
# Opsional: URL manual (mis. stub uji lokal). Kosongkan untuk produksi.
# GEMINI_API_URL=

# ---- LLM 2: DeepSeek via Zro / MoonMath.ai (OpenAI-compatible) ----
# Provider Zro: https://zro.moonmath.ai/v1 dengan model deepseek-v4.1-flash
DEEPSEEK_API_KEY=sk-contoh-kunci-zro
DEEPSEEK_BASE_URL=https://zro.moonmath.ai/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_TIMEOUT_MS=30000
# Opsional: override endpoint langsung
# DEEPSEEK_API_URL=https://zro.moonmath.ai/v1/chat/completions

# ---- LLM 3: OpenRouter (fallback utama setelah DeepSeek) ----
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-contoh-kunci-openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=15000
# Opsional: override endpoint langsung
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ---- LLM 4: NVIDIA integrate.api.nvidia.com (cadangan sebelum Mock) ----
# https://build.nvidia.com → ambil API key (format nvapi-...)
NVIDIA_API_KEY=nvapi-contoh-kunci-nvidia
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Urutan model NVIDIA (openai/gpt-oss-20b sudah ditiadakan).
NVIDIA_MODELS=minimaxai/minimax-m3.1-flash,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,deepseek-ai/deepseek-v4.1-flash
# Timeout ketat fail-fast untuk NVIDIA (maks 10-15s)
NVIDIA_TIMEOUT_MS=12000
# Model reasoning: low/medium/high. "low" cukup untuk ekstraksi JSON dan lebih cepat.
NVIDIA_REASONING_EFFORT=low

# ---- LLM 5: OpenAI langsung (opsional) ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-contoh-kunci-openai
OPENAI_MODEL=gpt-4o-mini
# Opsional: override endpoint (default https://api.openai.com/v1/chat/completions)
# OPENAI_API_URL=

# Urutan grup penyedia: 1. Gemini -> 2. DeepSeek (Zro) -> 3. OpenRouter -> 4. NVIDIA -> 5. Mock.
LLM_PROVIDER_ORDER=gemini,deepseek,openrouter,nvidia

# Batas waktu per penyedia LLM (ms) dan pagu total seluruh rantai fallback (ms).
# Bila semua penyedia gagal, /api/chat membalas mockResponse (mode mock).
LLM_TIMEOUT_MS=15000
LLM_TOTAL_TIMEOUT_MS=60000
# Batas token keluaran model OpenAI-compatible (termasuk model reasoning).
LLM_MAX_TOKENS=4096

# String acak panjang untuk tanda tangan JWT
JWT_SECRET=ganti-dengan-string-acak-panjang

# Opsional: pakai Faraidh-API daring. Kosongkan agar mesin hitung lokal dipakai.
# FARAIDH_API_URL=
